{% set roles = get_user_roles(get_user()) %}
{
	"widgettype":"Menu",
	"options":{
		"target":"PopupWindow",
		"popup_options":{
			"archor":"cc",
			"width":"70%",
			"height":"70%"
		},
		"cwidth":10,
		"items":[
			{
				"name":"config",
				"label":"配置",
				"items":[
					{
						"name":"services",
						"label":"服务配置",
						"url":"{{entire_url('rag/ragservices')}}"
					},
					{
						"name":"service_options",
						"label":"服务选择",
						"url":"{{entire_url('rag/service_opts')}}"
					},
					{
						"name":"organ",
						"label":"机构",
						"url":"{{entire_url('rbac/organization')}}"
					},
					{
						"name":"codes",
						"label":"编码",
						"url":"{{entire_url('appbase/appcodes')}}"
					},
					{
						"name":"param",
						"label":"参数",
						"url":"{{entire_url('appbase/params')}}"
					}
				]
			},
			{
				"label":"上位应用",
				"name":"upapp",
				"items":[
					{
						"name":"uapi",
						"label":"接口",
						"url":"{{entire_url('uapi/uapi')}}"
					},
					{
						"name":"upapp",
						"label":"应用",
						"url":"{{entire_url('uapi/upapp')}}"
					}
				]
			},
			{
				"label":"下位应用",
				"name":"downapp",
				"url":"{{entire_url('dapi/downapp')}}"
			},
			{
				"name":"kdb",
				"label":"我的知识库",
				"icon": "{{entire_url('/imgs/kdb.svg')}}",
				"url": "{{entire_url('rag/kdb')}}"
			},
			{
				"name":"craw",
				"label":"知识获取",
				"items":[
                    {
                        "name": "urlorigin",
                        "icon": "{{entire_url('/imgs/urlorigin.svg')}}",
                        "label":"网上知识源",
                        "url": "{{entire_url('kdb/urlorigin')}}"
                    },
                    {
                        "name": "urlorigin",
